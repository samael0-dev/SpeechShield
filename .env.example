# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Model Settings
# Supported backends: hybrid, baseline, transformer, heuristic
MODEL_BACKEND=hybrid
TRANSFORMER_MODEL_NAME=vinai/bertweet-base
BASELINE_WEIGHTS_PATH=data/weights/baseline_model.joblib
TRANSFORMER_WEIGHTS_DIR=data/weights/bertweet_toxicity
TOXICITY_THRESHOLD=0.50
BORDERLINE_LOW=0.60
BORDERLINE_HIGH=0.80
FAST_PASS_SAFE_THRESHOLD=0.20
USE_EKPHRASIS=false

# Database (SQLite by default for local dev; use PostgreSQL in Docker/prod)
DATABASE_URL=sqlite:///./data/toxicity_logs.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/toxicity_db

# Message Brokers (Optional for real-time streaming)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_COMMENTS=social-comments-raw
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Social Media API Credentials (Optional)
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-toxicity-detector/1.0
